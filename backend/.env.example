# Select which hosted AI API powers classification and typed extraction.
# Values: openrouter or huggingface
AI_PROVIDER=huggingface

# Hugging Face Inference Providers token (create a fresh token with inference permissions)
HF_TOKEN=hf_your_new_token_here

# Put the exact model ID supported by Hugging Face Inference Providers.
# Example format: organization/model-name:fastest
HF_MODEL=your-supported-chat-model:fastest

# Optional OpenRouter configuration (used if AI_PROVIDER=openrouter).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Optional, separate vision OCR configuration (vision fallback remains OpenRouter).
OPENROUTER_VISION_MODEL=
